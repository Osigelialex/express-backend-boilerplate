{
  // Base config used by the editor, `tsc --noEmit`, ts-jest and tsx.
  // The production build uses tsconfig.build.json (same options, no tests).
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",

    // `@/foo` -> `src/foo`. Resolved at build time by tsc-alias, in tests by
    // jest's moduleNameMapper and in dev by tsx.
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },

    // Global type augmentations (e.g. `req.user`) live in src/@types.
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "types": ["node", "jest"],

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
