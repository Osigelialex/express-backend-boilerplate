# Copy to `.env` and fill in. Every variable is validated at startup by
# src/config/env.ts - the app refuses to boot with a missing/invalid value.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=Backend Boilerplate
# Comma-separated list of browser origins allowed by CORS (and Socket.IO).
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (nginx, a load balancer...).
# Needed so rate limiting sees real client IPs. Use 0 when exposed directly.
TRUST_PROXY=0
# Also write rotating log files to ./logs (stdout JSON logs are always on in
# production, which is what Docker/Kubernetes collect).
LOG_TO_FILE=false

# --- PostgreSQL -------------------------------------------------------------
# Used by Prisma. Inside docker-compose the host is `db` (compose overrides it).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
# Only read by docker-compose (database container + DATABASE_URL override).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# --- Redis (refresh-token denylist, OTPs, rate limits, BullMQ, Socket.IO) -----
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
REFRESH_TOKEN_SECRET=change-me-to-another-random-string-of-32-chars
# Keys the HMAC that protects one-time email-verification / password-reset codes.
ACTION_TOKEN_SECRET=change-me-to-a-third-random-string-of-32-chars
# Format: <number><s|m|h|d>
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# When false, new accounts are marked verified immediately and no email is sent.
REQUIRE_EMAIL_VERIFICATION=true

# --- Email (SMTP via nodemailer) ----------------------------------------------
# Leave SMTP_HOST empty in development: emails are only logged by the worker.
# With docker-compose.dev.yml, Mailpit catches mail: SMTP_HOST=mailpit SMTP_PORT=1025
# and shows it at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- Seed -------------------------------------------------------------------
# Initial admin created by `pnpm seed:dev` / `pnpm seed:prod` (idempotent).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Deployment (docker-compose.yml only) -------------------------------------
# Image to run in production, e.g. ghcr.io/<owner>/<repo>:latest
DOCKER_IMAGE=backend-boilerplate:latest
