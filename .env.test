# Loaded by the jest setup (src/__tests__/setup.env.ts) and by
# `pnpm migrate:test`. Contains no real secrets and is safe to commit.
#
# The e2e suite DELETES DATA in this database/schema and FLUSHES this Redis db.
# It uses a dedicated Postgres schema ("test") and Redis db 1 so it can share a
# server with development data without touching it.

NODE_ENV=test
PORT=4001
APP_NAME=Backend Boilerplate (test)
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=test
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-jwt-secret-that-is-at-least-32-characters
REFRESH_TOKEN_SECRET=test-refresh-secret-that-is-at-least-32-chars
ACTION_TOKEN_SECRET=test-action-secret-that-is-at-least-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REQUIRE_EMAIL_VERIFICATION=true

# Empty = log transport (nothing is sent); the email queue is mocked in e2e.
SMTP_HOST=
EMAIL_FROM=no-reply@example.com

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Password123!
