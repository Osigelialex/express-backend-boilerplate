{
  "name": "backend-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Express + TypeScript + Prisma + Redis + BullMQ + Socket.IO backend boilerplate",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"{src,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.ts\"",

    "test": "jest",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "pnpm migrate:test && jest --config jest.e2e.config.ts --runInBand",

    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate": "prisma migrate deploy",
    "migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "studio": "prisma studio",

    "seed:dev": "tsx scripts/dev.seed.ts",
    "seed:prod": "node dist/scripts/prod.seed.js",

    "worker:email": "node dist/src/workers/email.worker.js",
    "worker:email:dev": "nodemon --watch src --ext ts --legacy-watch --exec tsx src/workers/email.worker.ts",
    "worker:maintenance": "node dist/src/workers/maintenance.worker.js",
    "worker:maintenance:dev": "nodemon --watch src --ext ts --legacy-watch --exec tsx src/workers/maintenance.worker.ts",

    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down -v"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "prisma": "^6.2.1",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.19.2",
    "typescript": "~5.5.4"
  }
}
